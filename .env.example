# =============================================================================
# Interview Knowledge Graph - Environment Configuration
# Copy this file to .env and adjust values as needed
# =============================================================================

# -----------------------------------------------------------------------------
# Neo4j Graph Database
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=interview_graph_password
NEO4J_DATABASE=neo4j

# For local development outside Docker, use:
# NEO4J_URI=bolt://localhost:7687

# -----------------------------------------------------------------------------
# MongoDB Document Database
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=interview_db

# For local development outside Docker, use:
# MONGODB_URI=mongodb://localhost:27017

# -----------------------------------------------------------------------------
# FastAPI Backend
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://frontend:5173

# Auto-seed databases on startup (true/false)
AUTO_SEED=true

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api

# -----------------------------------------------------------------------------
# AI / NLP Configuration
# -----------------------------------------------------------------------------
# LLM Provider: mock | openai | gemini | llama
LLM_PROVIDER=mock

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Llama / Ollama (optional)
LLAMA_BASE_URL=http://localhost:11434
LLAMA_MODEL=llama3

# Sentence Transformers model
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Whisper model size: tiny | base | small | medium | large
WHISPER_MODEL=base

# Disable heavy AI model loading on startup (use mock pipeline)
AI_LAZY_LOAD=true

# -----------------------------------------------------------------------------
# Docker Compose overrides (used in docker-compose.yml)
# -----------------------------------------------------------------------------
NEO4J_AUTH=neo4j/interview_graph_password
MONGO_INITDB_DATABASE=interview_db
