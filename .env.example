# Interview Knowledge Graph - copy to .env

# Neo4j (inside Docker the host is "neo4j"; outside Docker use bolt://localhost:7687)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=interview_graph_password
NEO4J_DATABASE=neo4j

# MongoDB (outside Docker use mongodb://localhost:27017)
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=interview_db

# FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://frontend:5173

# Seed the databases on startup when the graph is empty (true/false)
AUTO_SEED=true
# Optional explicit dataset path (default: <project>/data/synthetic_interview_dataset.csv)
DATASET_PATH=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api

# Optional (evaluation is deterministic and needs none of these)
LLM_PROVIDER=mock

# Docker Compose
NEO4J_AUTH=neo4j/interview_graph_password
MONGO_INITDB_DATABASE=interview_db